# Copy to .env and fill in. Nothing here has a working default in production:
# the app refuses to start with APP_ENV=production if a security-critical value
# is missing (see config.validate_production_config).

# --- Server ---
APP_ENV=development
PORT=8000
LOG_LEVEL=INFO
# Public https origin of this API, no trailing slash. ngrok URL in development.
PUBLIC_BASE_URL=https://your-api.example.com

# --- CORS ---
# Exact origins only, comma-separated. Never use "*" and never a wildcard
# domain: any origin listed here can read authenticated responses.
CORS_ORIGINS=http://localhost:3000

# --- Auth ---
# openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14

# Encrypts Google OAuth refresh tokens at rest.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Database ---
# Leave empty in development to use a local SQLite file.
DATABASE_URL=postgresql://user:password@host:5432/clinic_receptionist

# --- VAPI (voice agent) ---
VAPI_API_KEY=
# Any long random string. Set the SAME value as the assistant's server secret;
# webhooks without it are rejected.
VAPI_WEBHOOK_SECRET=
# Optional: a VAPI phone number id to auto-attach during onboarding.
VAPI_PHONE_NUMBER_ID=

# --- Google Calendar ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web).
# Enable the Google Calendar API on the project first.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the redirect URI registered on the OAuth client exactly.
GOOGLE_OAUTH_REDIRECT_URI=https://your-api.example.com/api/v1/integrations/google/callback

# --- WhatsApp (Meta Cloud API, no WATI) ---
# Meta Business Manager -> WhatsApp -> API Setup.
# Use a System User token, not the 24-hour temporary one.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# App Settings -> Basic -> App Secret. Verifies X-Hub-Signature-256.
WHATSAPP_APP_SECRET=
# Any string you choose; enter the same value when subscribing the webhook.
WHATSAPP_VERIFY_TOKEN=

# --- Scheduling ---
DEFAULT_TIMEZONE=Asia/Kolkata
REMINDER_SCHEDULER_ENABLED=true
REMINDER_POLL_SECONDS=300
